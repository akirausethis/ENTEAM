generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
id              String   @id @default(uuid())
  name            String   @unique
  email           String   @unique
  password        String
  displayName     String?  // Tambahkan tanda tanya biar opsional
  bio             String?  // Tambahkan tanda tanya biar opsional
  twoFactorEnabled Boolean  @default(false)
  twoFactorCode   String?  // Tambahkan tanda tanya biar opsional
  boards    Board[]  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Board {
  id        String   @id @default(uuid())
  title     String
  userId    String   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists     List[]   // Relasi ke List (Tanpa nama string agar simpel)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model List {
  id        String   @id @default(uuid())
  title     String
  order     Int
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Card {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  deadline    String?
  // Tambahkan dua field ini
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  isCompleted Boolean  @default(false)
  listId      String
  list        List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}